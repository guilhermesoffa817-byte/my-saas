generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                String   @id @default(cuid())
  nome              String
  email             String   @unique
  senhaHash         String
  nomeNegocio       String
  telefone          String?
  /// CPF de quem trabalha sozinha, ou CNPJ de quem já abriu empresa.
  documento         String?
  /// Percentual usado para estimar o imposto do mês. É estimativa, não guia fiscal.
  impostoPercentual Int      @default(6)
  /// Código do link de indicação desta pessoa. Só quem indica tem um.
  codigoIndicacao   String?  @unique
  /// Código de quem trouxe esta conta, guardado no momento do cadastro.
  indicadoPor       String?
  cep               String?
  endereco          String?
  /// Chave Pix do estúdio, usada para cobrar os clientes dele.
  pixChave          String?
  /// Cidade de quem recebe. O código Pix exige, junto com o nome.
  pixCidade         String?
  /// Quando lembrar: véspera, no dia, três dias depois, sete dias depois.
  lembreteAntes     Boolean  @default(true)
  lembreteNoDia     Boolean  @default(true)
  lembreteTresDias  Boolean  @default(true)
  lembreteSeteDias  Boolean  @default(true)
  papel             String   @default("dona")
  /// Sobe a cada troca de senha. A sessão carrega esse número, então quem
  /// entrou com a senha antiga perde o acesso quando a senha muda.
  sessaoVersao      Int      @default(0)
  criadoEm          DateTime @default(now())

  assinatura     Assinatura?
  clientes       Cliente[]
  servicos       Servico[]
  agendamentos   Agendamento[]
  pagamentos     Pagamento[]
  lancamentos    Lancamento[]
  cobrancas      Cobranca[]
  vencimentos    Vencimento[]
  repeticoes     RepeticaoDeVencimento[]
  documentos     Documento[]
  pedidosDeSenha PedidoDeSenha[]

  @@index([indicadoPor])
}

model Assinatura {
  id           String   @id @default(cuid())
  usuarioId    String   @unique
  status       String   @default("teste")
  /// Qual plano está valendo: define se a aba Finanças aparece.
  plano        String   @default("mensal")
  validaAte    DateTime
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Pagamento {
  id            String    @id @default(cuid())
  usuarioId     String
  valorCentavos Int       @default(16900)
  plano         String    @default("mensal")
  competencia   String
  status        String    @default("aguardando")
  observacao    String?
  criadoEm      DateTime  @default(now())
  respondidoEm  DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([status])
}

model Cliente {
  id           String    @id @default(cuid())
  usuarioId    String
  nome         String
  telefone     String
  email        String?
  cpf          String?
  endereco     String?
  nascimento   DateTime?
  observacoes  String?
  /// Quem pediu para não receber lembrete de cobrança.
  semLembretes Boolean   @default(false)
  criadoEm     DateTime  @default(now())

  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]
  cobrancas    Cobranca[]

  @@index([usuarioId])
}

model Servico {
  id            String   @id @default(cuid())
  usuarioId     String
  nome          String
  precoCentavos Int
  duracaoMin    Int      @default(60)
  descricao     String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@index([usuarioId])
}

model Agendamento {
  id          String   @id @default(cuid())
  usuarioId   String
  clienteId   String
  servicoId   String
  inicio      DateTime
  status      String   @default("agendado")
  observacoes String?
  criadoEm    DateTime @default(now())

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servico   Servico    @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  cobrancas Cobranca[]

  @@index([usuarioId, inicio])
  @@index([clienteId])
}

/// Dinheiro que entrou ou saiu fora dos atendimentos: aluguel, material, um extra.
model Lancamento {
  id            String   @id @default(cuid())
  usuarioId     String
  tipo          String
  descricao     String
  categoria     String?
  valorCentavos Int
  data          DateTime
  criadoEm      DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, data])
}

/// Dinheiro a receber de um cliente do estúdio. Nasce de um horário da agenda
/// ou solto, pela ficha do cliente.
model Cobranca {
  id               String    @id @default(cuid())
  usuarioId        String
  clienteId        String
  /// O horário que originou a cobrança, quando houver.
  agendamentoId    String?
  valorCentavos    Int
  /// Dia de calendário, sem hora. "Atrasada" se calcula a partir daqui.
  vencimento       DateTime  @db.Date
  /// aberta, paga ou cancelada. Atrasada não se grava: é conta de data.
  situacao         String    @default("aberta")
  formaDePagamento String?
  pagaEm           DateTime? @db.Date
  /// O lançamento criado ao receber, nas cobranças que não vêm da agenda.
  /// Guardado para que marcar como paga duas vezes não lance duas vezes.
  lancamentoId     String?
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  usuario     Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente     Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  agendamento Agendamento?         @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  lembretes   LembreteDeCobranca[]

  @@index([usuarioId, situacao, vencimento])
  @@index([clienteId])
  @@index([agendamentoId])
}

/// Cada mensagem de lembrete que a pessoa confirmou ter enviado.
/// O par cobrança e momento é único: o mesmo aviso não se registra duas vezes.
model LembreteDeCobranca {
  id         String   @id @default(cuid())
  cobrancaId String
  momento    String
  enviadoEm  DateTime @default(now())

  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)

  @@unique([cobrancaId, momento])
}

/// Tudo o que tem data e cobra uma atitude: a conta de luz, o aluguel, o fim de
/// um contrato, o dia do reajuste.
///
/// Fica em tabela própria, e não em Lancamento, porque conta com data futura
/// não é dinheiro que já saiu. Misturar as duas coisas mudaria o sentido dos
/// números que o estúdio já conhece. Só vira saída quando alguém marcar o pago.
model Vencimento {
  id            String    @id @default(cuid())
  usuarioId     String
  /// "conta" para o que se paga, "prazo" para data de contrato.
  tipo          String    @default("conta")
  descricao     String
  categoria     String?
  /// Prazo de contrato nem sempre tem valor; conta sempre tem.
  valorCentavos Int?
  /// Dia de calendário, sem hora. "Atrasado" se calcula a partir daqui.
  data          DateTime  @db.Date
  pago          Boolean   @default(false)
  pagoEm        DateTime? @db.Date
  /// A saída criada ao pagar. Guardada para que pagar duas vezes não lance duas.
  lancamentoId  String?
  /// A repetição que gerou esta ocorrência, quando vier de uma.
  repeticaoId   String?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  usuario   Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  repeticao RepeticaoDeVencimento? @relation(fields: [repeticaoId], references: [id], onDelete: Cascade)

  @@unique([repeticaoId, data])
  @@index([usuarioId, pago, data])
}

/// O combinado que se repete todo mês. As ocorrências saem daqui, completadas
/// quando a tela abre, sem tarefa agendada.
model RepeticaoDeVencimento {
  id            String    @id @default(cuid())
  usuarioId     String
  tipo          String    @default("conta")
  descricao     String
  categoria     String?
  valorCentavos Int?
  /// A primeira data do combinado. O dia dela é a referência todo mês.
  primeira      DateTime  @db.Date
  /// Até quando vale. Sem data final, o Bossa mantém os próximos doze meses.
  ate           DateTime? @db.Date
  ativa         Boolean   @default(true)
  criadoEm      DateTime  @default(now())

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  vencimentos Vencimento[]

  @@index([usuarioId, ativa])
}

/// Um contrato, um boleto ou uma conta que a pessoa enviou para o Bossa ler.
///
/// O arquivo em si não fica aqui: fica num espaço privado do Supabase, e esta
/// tabela guarda só o caminho até ele. O conteúdo lido vira itens, que só viram
/// vencimento depois que alguém conferir.
model Documento {
  id               String    @id @default(cuid())
  usuarioId        String
  nome             String
  /// Caminho dentro do espaço privado de arquivos.
  caminho          String
  tipoDoArquivo    String
  tamanhoBytes     Int
  paginas          Int?
  /// lendo, pronto, conferido ou falhou.
  situacao         String    @default("lendo")
  /// Por que não deu para ler, quando não deu. Nunca guarda trecho do documento.
  motivoDaFalha    String?
  /// O que o documento é, em uma linha, segundo a leitura.
  tipoDeDocumento  String?
  partes           String?
  resumo           String?
  fimDoContrato    DateTime? @db.Date
  reajusteEm       DateTime? @db.Date
  indiceDeReajuste String?
  multa            String?
  avisoPrevio      String?
  /// Quando a leitura começou, para a tela saber se travou no meio.
  leituraEm        DateTime?
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  usuario Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens   ItemDoDocumento[]

  @@index([usuarioId, situacao, criadoEm])
}

/// Cada coisa que a leitura encontrou no documento, ainda não lançada.
///
/// Guarda o trecho de origem e a página para que a pessoa confira o que o Bossa
/// leu contra o que está escrito, sem abrir o arquivo.
model ItemDoDocumento {
  id            String    @id @default(cuid())
  documentoId   String
  descricao     String
  /// entrada ou saida.
  tipo          String    @default("saida")
  valorCentavos Int?
  data          DateTime? @db.Date
  /// "mensal" quando se repete; vazio quando é uma vez só.
  repeticao     String?
  /// Até quando a repetição vale.
  repeteAte     DateTime? @db.Date
  /// O pedaço do documento de onde isto saiu, e em que página.
  trecho        String?
  pagina        Int?
  /// A leitura marcou como duvidoso: a pessoa precisa olhar com atenção.
  duvidoso      Boolean   @default(false)
  /// aceito, descartado ou nada ainda.
  decisao       String?
  /// O vencimento criado quando o item foi aceito.
  vencimentoId  String?
  criadoEm      DateTime  @default(now())

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([documentoId])
}

/// Um pedido de nova senha, esperando virar link.
///
/// O código em si não fica aqui: só o resumo dele. Quem abrir o banco não
/// consegue entrar em conta nenhuma. Vale meia hora e uma vez só.
model PedidoDeSenha {
  id         String    @id @default(cuid())
  usuarioId  String
  /// SHA-256 do código. O código só existe no link, uma vez.
  codigoHash String?   @unique
  /// Quem ainda não recebeu link aparece na administração como pedido aberto.
  entregueEm DateTime?
  expiraEm   DateTime
  usadoEm    DateTime?
  criadoEm   DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, usadoEm])
}
