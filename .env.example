# Banco de dados PostgreSQL.
# Na Vercel essa variável é criada sozinha quando você conecta um banco ao projeto.
# No Supabase (usado pela Netlify), copie em Connect:
#   DATABASE_URL = "Transaction pooler"  (porta 6543)
#   DIRECT_URL   = "Direct connection"   (porta 5432)
# Se o seu banco não tiver pooler, use o mesmo endereço nas duas variáveis.
DATABASE_URL="postgresql://usuario:senha@servidor:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta, usada só pelas migrações (`prisma migrate deploy`).
DIRECT_URL="postgresql://usuario:senha@servidor:5432/postgres"

# Segredo usado para assinar os cookies de sessão (troque por algo longo e aleatório!)
SESSAO_SEGREDO="troque-este-segredo-por-uma-chave-longa-e-aleatoria"

# Dados da cobrança por Pix
# Chave Pix no formato exato do seu banco: telefone com +55, CPF só com
# dígitos, e-mail, ou chave aleatória.
PIX_CHAVE="+5500000000000"
PIX_NOME="Nome que aparece no seu Pix"
# Preços dos planos, em centavos (18900 = R$ 189,00).
# ATENÇÃO: as variáveis configuradas no Netlify têm prioridade sobre o código.
# Se elas existirem lá com os valores antigos, o site continua cobrando os
# valores antigos: atualize ou apague as quatro no painel do Netlify. Variável
# ausente, vazia ou zerada usa o padrão de src/lib/assinatura.ts.
#
# Plano Simples (códigos "mensal" e "anual"): agenda, link, clientes, serviços,
# cobrança pelo WhatsApp e Finanças.
ASSINATURA_VALOR_CENTAVOS="18900"
ASSINATURA_ANUAL_CENTAVOS="189000"

# Plano Completo (códigos "vip_mensal" e "vip_anual"; o nome das variáveis
# continua VIP para não precisar renomear no Netlify): tudo do Simples, mais
# lembretes, contas a pagar, documentos, custos, relatório, equipe e assistente.
ASSINATURA_VIP_CENTAVOS="32900"
ASSINATURA_VIP_ANUAL_CENTAVOS="256900"

# Conta de administração criada pelo `npm run seed` (só no seu computador)
ADMIN_EMAIL="admin@meuestudio.com.br"
ADMIN_SENHA="mudeessasenha123"

# Endereço público do site, usado para montar os links de indicação.
ENDERECO_DO_SITE="https://agendaonlinecontabilidade.netlify.app"

# Percentual de comissão sugerido no painel para quem indica.
COMISSAO_PERCENTUAL="40"

# Inteligência artificial (plano Completo): leitura de documentos, sugestão de
# classificação dos custos e o assistente de negócios. Sem a chave, a seção
# Documentos continua guardando arquivo (os vencimentos são criados à mão), os
# Custos usam só as regras automáticas e a tela do Assistente explica que ele
# ainda não foi ativado. A franquia mensal de cada recurso fica em
# src/lib/recursos.ts.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODELO="claude-sonnet-5-5"

# Espaço privado de arquivos no Supabase, usado pelos documentos.
# A chave de serviço só existe no servidor e nunca vai para o navegador.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Quem responde pelo Bossa, mostrado nas páginas /privacidade e /termos.
# Em branco, as páginas mostram "[PREENCHER: ...]" no lugar.
RESPONSAVEL_NOME=""
RESPONSAVEL_DOCUMENTO=""
CONTATO_EMAIL=""
ENCARREGADO_DE_DADOS=""
