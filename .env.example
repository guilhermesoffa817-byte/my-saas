# Banco de dados PostgreSQL.
# Na Vercel essa variável é criada sozinha quando você conecta um banco ao projeto.
# No Supabase (usado pela Netlify), copie em Connect:
#   DATABASE_URL = "Transaction pooler"  (porta 6543)
#   DIRECT_URL   = "Direct connection"   (porta 5432)
# Se o seu banco não tiver pooler, use o mesmo endereço nas duas variáveis.
DATABASE_URL="postgresql://usuario:senha@servidor:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta, usada só pelas migrações (`prisma migrate deploy`).
DIRECT_URL="postgresql://usuario:senha@servidor:5432/postgres"

# Segredo usado para assinar os cookies de sessão (troque por algo longo e aleatório!)
SESSAO_SEGREDO="troque-este-segredo-por-uma-chave-longa-e-aleatoria"

# Dados da cobrança por Pix
# Chave Pix no formato exato do seu banco: telefone com +55, CPF só com
# dígitos, e-mail, ou chave aleatória.
PIX_CHAVE="+5500000000000"
PIX_NOME="Nome que aparece no seu Pix"
# Mensal e anual, em centavos. O anual em branco vira dez mensalidades.
ASSINATURA_VALOR_CENTAVOS="16900"
ASSINATURA_ANUAL_CENTAVOS="169000"

# Plano VIP, que libera a aba Finanças.
ASSINATURA_VIP_CENTAVOS="32900"
ASSINATURA_VIP_ANUAL_CENTAVOS="329000"

# Conta de administração criada pelo `npm run seed` (só no seu computador)
ADMIN_EMAIL="admin@meuestudio.com.br"
ADMIN_SENHA="mudeessasenha123"
